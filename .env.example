# ───────── Cloudflare credentials ─────────
# Create at https://dash.cloudflare.com/profile/api-tokens
# Permissions: Zone -> DNS -> Edit   (+ Zone -> Zone -> Read if CF_ZONE_ID is left empty)
CF_API_TOKEN=your_cloudflare_api_token
# Optional: Zone ID (dashboard -> domain -> Overview, right column). Saves one API call.
CF_ZONE_ID=
# Comma separated FQDNs to keep in sync
CF_RECORDS=vps.example.com

# ───────── DDNS options ─────────
CF_ENABLE_IPV4=true
CF_ENABLE_IPV6=true
CF_CREATE_MISSING=true
# Only applied when a record is created
CF_PROXIED=false
CF_TTL=60
# Seconds between DDNS checks / forced re-verify with Cloudflare
DDNS_INTERVAL=300
DDNS_FORCE_SYNC=3600

# ───────── PPPoE uplink (pppd / pon) ─────────
# auto = enabled when /etc/ppp/peers/$PPP_PROVIDER exists | true | false
# While PPP_IFACE is up, the IPv4 default route is forced onto it (other default
# routes stay as backups). When it drops: redial; if that fails use DHCP on NET_IFACE
# and keep redialing every PPP_RETRY_INTERVAL seconds.
PPP_ENABLE=auto
# The only ppp interface allowed — pppd behind any other pppN (ppp1...) is killed
PPP_IFACE=ppp0
# Peer name used with pon / poff (pppoeconf default: dsl-provider)
PPP_PROVIDER=dsl-provider
PPP_DIAL_TIMEOUT=30
PPP_RETRY_INTERVAL=60
PPP_ROUTE_METRIC=0

# ───────── Network watchdog ─────────
CHECK_INTERVAL=30
CHECK_TARGETS=1.1.1.1,8.8.8.8,9.9.9.9
# auto | ping | tcp
CHECK_METHOD=auto
CHECK_TCP_PORT=443
# Consecutive failed checks before recovery starts
FAIL_THRESHOLD=3
# Physical NIC for DHCP fallback / recovery (never ppp*). Leave empty to auto-detect
# (non-ppp default route, then the NIC in the PPPoE peer file, then first NIC).
NET_IFACE=
RECOVERY_WAIT=20
RECOVERY_COOLDOWN=300
BOOT_GRACE=60
# Reboot the VPS if recovery keeps failing (off by default)
REBOOT_ON_FAILURE=false
REBOOT_AFTER_ROUNDS=3

LOG_LEVEL=INFO
